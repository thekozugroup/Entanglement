  "daemon_sha256": "ee90123fee6074b3e8358a2bad7ac913d36300953675a7613ee9f75e85c46905",
  "design": "6 AB/BA paired blocks of 1024 sequential greeting jobs and 48 local image jobs (two rotations of 24 distinct JPEGs, four concurrent calls). Both clients make actual entangle_rpc::Client::compute_dispatch calls, assert exact worker ID and expected output bytes for every call. One signed, already-warmed stock daemon serves all calls. Each fresh driver reads identical request/golden files before the timed interval, original pixels compared independently to Pillow via Python; wall includes verification, latency ends at typed response. Client process CPU from procfs enclosing timed section, excluding input/golden setup. Throughput, p95 and per-image client CPU criteria frozen before timing. No source or daemon change in frozen checkout.",
  "driver_rs": "use entangle_rpc::{Client,ComputeDispatchParams};\nuse std::{path::PathBuf, sync::Arc, time::Instant};\nuse tokio::task::JoinSet;\nfn ticks()->u64 {\n let s=std::fs::read_to_string(\"/proc/self/stat\").unwrap();let fields:Vec<_>=s.rsplit_once(')').unwrap().1.split_whitespace().collect();\n fields[11].parse::<u64>().unwrap()+fields[12].parse::<u64>().unwrap()\n}\n#[tokio::main(flavor=\"current_thread\")]\nasync fn main(){\n let args:Vec<_>=std::env::args().collect();let socket=PathBuf::from(&args[1]);\n let requests:Arc<Vec<ComputeDispatchParams>>=Arc::new(serde_json::from_reader(std::fs::File::open(&args[2]).unwrap()).unwrap());\n let repeats=args[3].parse::<usize>().unwrap();\n let concurrency=args[4].parse::<usize>().unwrap();\n let expected_peer=Arc::new(args[5].clone());let out=PathBuf::from(&args[6]);\n let expected=Arc::new((0..requests.len()).map(|i|std::fs::read(out.join(format!(\"{i}.bin\"))).unwrap()).collect::<Vec<_>>());\n let mut pending=JoinSet::new(); let initial_cpu=ticks();let start=Instant::now();\n for worker in 0..concurrency{\n  let requests=requests.clone();let cli=Client::new(&socket);let peer=expected_peer.clone();let expected=expected.clone();\n  pending.spawn(async move {\n   let mut data=Vec::new();\n   for idx in (worker..repeats).step_by(concurrency){\n    let i=idx%requests.len();let start=Instant::now();let res=cli.compute_dispatch(&requests[i]).await.unwrap();let elapsed=start.elapsed().as_nanos() as u64;\n    assert_eq!(res.chosen_peer,*peer);assert_eq!(res.output,expected[i]);data.push(elapsed);\n   }\n   data\n  });\n }\n let mut samples=Vec::new();while let Some(t)=pending.join_next().await{samples.extend(t.unwrap());}let wall=start.elapsed().as_secs_f64();samples.sort();\n println!(\"{}\",serde_json::json!({\"count\":samples.len(),\"p50_ms\":samples[(samples.len()/2)-1] as f64/1e6,\"p95_ms\":samples[(samples.len()*95).div_ceil(100)-1] as f64/1e6,\"rate\":samples.len()as f64/wall,\"wall_s\":wall,\"cpu_ticks\":ticks()-initial_cpu}));\n}\n",
  "limits": {
    "hello_p95": true,
    "hello_throughput": true,
    "image_client_cpu": true,
    "image_p95": true,
    "image_throughput": true
  },
  "orchestrator_py": "import sys,time,tempfile,tomllib,subprocess,os,threading,json\nfrom contextlib import ExitStack\nfrom pathlib import Path\nroot=Path('/workspace/Entanglement');sys.path.insert(0,str(root/'scripts'))\nimport benchmark_image_batch as b\nbase=Path('/tmp/entangle-final-frozen/candidate');out=Path(sys.argv[1]);rows=[]\nscope={};exec(Path('/tmp/entangle-capacity-window.py').read_text().split('t=Thread(target=monitor)')[0],scope)\ncases=b.corpus(Path('/usr/share/matplotlib/mpl-data/sample_data/grace_hopper.jpg'))\nwith tempfile.TemporaryDirectory(prefix='entangle-client-') as temp,ExitStack() as stack:\n d=Path(temp);node=b.Node(d/'worker',base/'entangle');trusted=b.Node(d/'trusted',base/'entangle');node.trust(trusted)\n node.start(stack,base/'entangled',0,[])\n for label,name,catalog,wasm in [('hello','hello-world',root/'examples',root/'crates/entangle-host/tests/fixtures/hello-pong.wasm'),('image','image-resize',root/'plugins',root/'target/catalog-smoke/wasm32-wasip2/release/entangle_image_resize.wasm')]:\n  node.command('plugins','install',name,'--catalog',catalog,'--wasm',wasm,'--no-load');pkg=node.home/'.entangle/plugins'/name;plug=tomllib.loads((pkg/'entangle.toml').read_text())['plugin']['id'];node.command('plugins','load',pkg)\n  xs=[b'job00000000'] if label=='hello' else [x for x,_ in cases]\n  dest=d/label;dest.mkdir();params=[]\n  for j,x in enumerate(xs):\n   msg=b.dispatch_frame(plug,x,[node.peer]);params.append(json.loads(msg)['params']);reply=b.decoded(b.exchange(node.sock,msg)[1]);assert reply['chosen_peer']==node.peer;output=bytes(reply['output'])\n   if label=='image':b.verify_png(output,cases[j][1])\n   else:assert output==b'Hello, job00000000!'\n   (dest/f'{j}.bin').write_bytes(output)\n  (dest/'params.json').write_text(json.dumps(params,separators=(',',':')))\n def run(build,route,n):\n  dest=d/route;bin='/tmp/entangle-rpc-client-'+build;c=1 if route=='hello' else 4\n  p=subprocess.check_output([bin,node.sock,dest/'params.json',str(n),str(c),node.peer,dest]);v=json.loads(p)\n  v['cpu_ms_per_job']=1000*v['cpu_ticks']/os.sysconf('SC_CLK_TCK')/n\n  return v\n for build in ['stock','patched']:\n  for route in ['hello','image']:run(build,route,24)\n t=threading.Thread(target=scope['monitor']);t.start()\n try:\n  for r in range(6):\n   for route in (('hello','image') if r%2==0 else ('image','hello')):\n    for build in (('stock','patched') if r%2==0 else ('patched','stock')):\n     res=run(build,route,1024 if route=='hello' else 48); row=dict(pair=r,route=route,build=build,utc=time.strftime('%H:%M:%S',time.gmtime()),**res)\n     rows.append(row);out.write_text(json.dumps(rows,indent=2)+'\\n');print(row,flush=True)\n finally:\n  scope['stopped'].set();t.join();Path(str(out)+'.cpu').write_text(json.dumps(scope['rows'],indent=2))\n",
  "patch": "--- a/crates/entangle-rpc/src/client.rs\n+++ b/crates/entangle-rpc/src/client.rs\n@@ -6,6 +6,14 @@\n use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};\n use tokio::net::UnixStream;\n \n+#[derive(Serialize)]\n+struct Request<'a, P> {\n+    id: u64,\n+    jsonrpc: &'static str,\n+    method: &'a str,\n+    params: P,\n+}\n+\n /// Default connect timeout: 2 seconds. Short enough to fail fast in the CLI;\n /// long enough to tolerate a daemon that's just started up.\n pub const DEFAULT_CONNECT_TIMEOUT: Duration = Duration::from_secs(2);\n@@ -62,12 +70,12 @@\n         }\n \n         let id = self.next_id.fetch_add(1, Ordering::Relaxed);\n-        let req = serde_json::json!({\n-            \"jsonrpc\": \"2.0\",\n-            \"id\": id,\n-            \"method\": method,\n-            \"params\": params,\n-        });\n+        let req = Request {\n+            id,\n+            jsonrpc: \"2.0\",\n+            method,\n+            params,\n+        };\n         let line = serde_json::to_string(&req)?;\n \n         let stream =\n@@ -89,7 +97,7 @@\n             .await?\n             .ok_or_else(|| RpcError::Malformed(\"empty response\".into()))?;\n \n-        let resp: serde_json::Value = serde_json::from_str(&resp_line)?;\n+        let mut resp: serde_json::Value = serde_json::from_str(&resp_line)?;\n \n         if resp[\"jsonrpc\"] != \"2.0\" || resp[\"id\"].as_u64() != Some(id) {\n             return Err(RpcError::Malformed(\n@@ -112,9 +120,9 @@\n         }\n \n         let result = resp\n-            .get(\"result\")\n-            .ok_or_else(|| RpcError::Malformed(\"missing result\".into()))?\n-            .clone();\n+            .as_object_mut()\n+            .and_then(|object| object.remove(\"result\"))\n+            .ok_or_else(|| RpcError::Malformed(\"missing result\".into()))?;\n \n         let typed: R = serde_json::from_value(result)?;\n         Ok(typed)\n",
  "patched_client_driver_sha256": "4bb318daa7551531ac7fa5314ac33225349c3782e4e870fc68917e8d2fc8933f",
