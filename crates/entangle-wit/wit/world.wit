package entangle:plugin@0.1.0;

interface types {
  variant plugin-error {
    invalid-input(string),
    resource-exhausted(string),
    capability-denied(string),
    internal(string),
  }

  type stream-handle = u64;
}

/// Imports a tier-1/2/3 plugin gets from the host.
/// Tiers 4+ get this PLUS the privileged worlds (defined elsewhere).
world plugin {
  import logging;
  import capability;
  import host-info;
  import types;
  use types.{plugin-error};

  // The plugin's exported entrypoint.
  export run: func(input: list<u8>) -> result<list<u8>, plugin-error>;
}

world stream-plugin {
  import logging;
  import capability;
  import host-info;
  import %stream;
  import types;
  use types.{plugin-error, stream-handle};

  export start-stream: func(input: list<u8>) -> result<stream-handle, plugin-error>;
}

/// The optional hot-reload hook (spec §3.3). A component of either world
/// above may also export `migrate`; when the kernel replaces a loaded version
/// of a plugin with this one it calls `migrate` on a fresh instance of the
/// **new** version, with the version it replaces, before any call is routed
/// to it. `ok` lets the swap proceed; `err` keeps the old version running
/// and refuses the reload. A component without the export needs no
/// conversion. Either way the new version takes every new call at once,
/// while calls and streams already running on the old version finish there
/// (drain-and-swap), so both versions can use the plugin's storage at the
/// same time until the old one has drained.
///
/// The instance gets the new version's capability grants, so a plugin can
/// rewrite its own storage (`/data`) into the new version's format here.
world migrate-hook {
  export migrate: func(from-version: string) -> result<_, string>;
}

/// A `plugin` world component that exports the `migrate` hook.
world migratable-plugin {
  include plugin;
  include migrate-hook;
}

/// A `stream-plugin` world component that exports the `migrate` hook.
world migratable-stream-plugin {
  include stream-plugin;
  include migrate-hook;
}

